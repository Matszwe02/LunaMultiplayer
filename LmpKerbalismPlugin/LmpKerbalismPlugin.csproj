<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>KerbalismSync.Server</RootNamespace>
    <AssemblyName>LmpKerbalismPlugin</AssemblyName>
    <Description>Server-side state store for the Kerbalism multiplayer plugin.</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="KerbalismPlugin.cs" />
    <Compile Include="KerbalismStateStore.cs" />
    <Compile Include="KerbalismAuthority.cs" />
    <Compile Include="Shared\Protocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not copied to the server's Plugins folder: the plugin only uses types that are
         already loaded there by the host process. -->
    <ProjectReference Include="..\Server\Server.csproj" Private="false" />
  </ItemGroup>

  <Target Name="DeployToServerPlugins" AfterTargets="Build">
    <PropertyGroup>
      <PluginTargetDir>$(MSBuildThisFileDirectory)..\Server\bin\$(Configuration)\net10.0\Plugins</PluginTargetDir>
    </PropertyGroup>
    <MakeDir Directories="$(PluginTargetDir)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(PluginTargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).pdb" DestinationFolder="$(PluginTargetDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(OutputPath)$(AssemblyName).pdb')" />
  </Target>

</Project>
